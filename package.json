{
  "name": "edutrack360",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc",
    "migrate": "node-pg-migrate",
    "db:test:up": "docker compose -f infra/docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f infra/docker-compose.test.yml down -v"
  },
  "dependencies": {
    "iron-session": "^9.1.1",
    "jose": "^6.2.18",
    "openid-client": "^6.9.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dotenv": "18.0.10",
    "eslint": "^10.15.0",
    "node-pg-migrate": "9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.1"
  }
}
