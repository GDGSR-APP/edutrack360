# Noms de variables uniquement. Aucune valeur reelle ne doit jamais figurer ici
# ni dans aucun fichier versionne. Les valeurs vivent dans les variables
# d'environnement gerees par Coolify (conteneur portail et conteneur ETL).

# --- Authentification Google Workspace OIDC (A2) ---
# Secret OAuth : jamais dans le depot, jamais dans le code, jamais dans un
# fichier de configuration versionne (point 5).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Domaine attendu, verifie contre la revendication "hd" du jeton d'identite,
# jamais contre le suffixe de l'adresse electronique (point 2).
GOOGLE_WORKSPACE_ALLOWED_DOMAIN=

# --- Session applicative (iron-session) ---
SESSION_COOKIE_PASSWORD=
SESSION_COOKIE_NAME=

# --- Base applicative (conteneur Postgres dedie, reseau portail) ---
# Utilise par l'API en production. Aucun GRANT table (A1).
APP_ROLE_DATABASE_URL=

# --- ETL (conteneur dedie, execution ponctuelle, reseau isole, point 1) ---
# Ecriture dans la base applicative uniquement, via fonctions dediees.
ETL_LOADER_DATABASE_URL=
# Lecture seule sur la Supabase source. Ne doit exister qu'apres
# l'autorisation ecrite (Phase 0, porte bloquante).
ETL_SOURCE_READER_DATABASE_URL=
# Store de correspondance pseudonymisation, jamais dans le reseau du portail,
# jamais accessible au role de l'API (A5).
PSEUDONYM_MAPPING_STORE_URL=

# --- Migrations DDL (edutrack_schema_owner) ---
# Usage local / pipeline de migration controle uniquement. Jamais utilise par
# l'application en execution.
SCHEMA_OWNER_DATABASE_URL=
